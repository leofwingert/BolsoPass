# Modos: `pnpm dev` usa .env.development (http = backend real);
#        `pnpm dev:mock` usa .env.mock (API em memória, sem backend).
VITE_API_MODE=http
# Base da API REST (o Vite faz proxy de /api para http://localhost:8080).
VITE_API_BASE_URL=/api/v1
# WebSocket. Padrão: ws(s)://<host da página>/ws, com proxy do Vite para o backend.
# VITE_WS_URL=ws://localhost:8080/ws
